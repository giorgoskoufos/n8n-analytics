{
  "name": "n8n-metrics-dashboard",
  "version": "1.0.0",
  "description": "Real-time analytics dashboard for self-hosted n8n",
  "author": "Giorgos Koufos",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test --test-concurrency=1 test/unit.test.js test/integration.test.js",
    "test:unit": "node --test test/unit.test.js",
    "test:integration": "node --test test/integration.test.js",
    "check": "npm run lint && npm test",
    "build:css": "npx @tailwindcss/cli -i ./public/css/input.css -o ./public/css/styles.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./public/css/input.css -o ./public/css/styles.css --watch",
    "build:hljs": "node src/scripts/vendorHljs.js"
  },
  "dependencies": {
    "@fontsource/open-sans": "5.3.0",
    "@fortawesome/fontawesome-free": "6.7.2",
    "bcrypt": "^6.0.0",
    "chart.js": "4.5.1",
    "dompurify": "3.4.13",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "flatted": "^3.4.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "marked": "18.0.10",
    "node-cron": "^4.2.1",
    "openai": "^6.32.0",
    "pg": "^8.20.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/cli": "^4.3.2",
    "eslint": "^9.39.5",
    "highlight.js": "11.12.0",
    "tailwindcss": "^4.3.2"
  }
}
