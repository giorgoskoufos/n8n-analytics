# Server Config
DASHBOARD_PORT=3000
# Minimum 32 characters — the server refuses to boot below that.
# Generate with: openssl rand -base64 48
DASHBOARD_JWT_SECRET='your_secure_random_secret_here'

# Where the local analytics replica lives. In Docker this MUST point inside a
# mounted volume, otherwise every redeploy destroys your execution history.
# Leave unset for local development (defaults to ./dashboard.sqlite).
#DASHBOARD_DB_PATH=/data/dashboard.sqlite

# Database Config (Connection to your n8n PostgreSQL)
DASHBOARD_DB_USER=postgres
DASHBOARD_DB_HOST=127.0.0.1
DASHBOARD_DB_NAME=n8n_data
DASHBOARD_DB_PASS=your_db_password
DASHBOARD_DB_PORT=5432

# Alternative Database Config (Direct URL)
#DASHBOARD_DATABASE_URL=postgres://user:pass@host:port/n8n_data?sslmode=disable

# n8n Editor Integration (for deep-linking errors in the UI)
N8N_EDITOR_BASE_URL=https://your-n8n-instance.com

# AI Chat Subsystem
#
# BOTH OF THESE ARE OPTIONAL NOW. Settings > Integrations > "Assistant model &
# API key" writes them into the dashboard's own database, which is the intended
# route: it needs no file on the host and no restart, and trying a different
# model stops being a deployment.
#
# What is set here is a FALLBACK, used only while nothing has been saved in
# Settings — so an existing deployment keeps working across the upgrade and a
# fresh one can still be configured entirely from the environment if that is how
# you prefer to run things. A value saved in Settings always wins, and the
# settings page says which of the two is in force.
#OPENAI_API_KEY=sk-proj-your-key-here

# Which model answers. Defaults to gpt-5.4-mini when neither this nor Settings
# says otherwise. Anything drop-in here has to accept `temperature` and do
# function tools on /v1/chat/completions — two things newer models increasingly
# do not: gpt-5-mini allows only the default temperature, and gpt-5.6-luna
# refuses function tools on this endpoint entirely. Smoke-test before switching.
#AI_MODEL=gpt-5.4-mini

# --- n8n documentation assistant (optional) ---------------------------------
# Lets the assistant answer "why does this happen" from the official n8n docs,
# alongside "what happened" from your own data.
#
# Nothing goes here. The service only supports authorization_code, so it has to
# be approved in a browser — and the credential it issues is bound to the
# approver's own account, which is why it is stored per user rather than per
# deployment. Connect it from Settings > Integrations, or on a headless box:
#
#     node src/scripts/connectDocsMcp.js <your-email>
#
# Only override the endpoint if you are pointing at something else:
# N8N_DOCS_MCP_URL=https://n8n.mcp.kapa.ai

# Background ETL Sync Frequency (in minutes, Optional, Defaults to 5)
SYNC_INTERVAL_MINUTES=5

# How many execution ids the incremental sync re-reads on every cycle. Postgres
# hands out ids at INSERT but commits land out of order, so a row with a lower id
# can appear after the sync has already passed it; this window catches it. The
# rows return through an idempotent upsert, so re-reading them is free of
# side effects. Optional, defaults to 500.
#SYNC_ID_OVERLAP=500

# How long an execution may stay absent from Postgres before its status is
# written off as 'unknown', in milliseconds. Optional, defaults to 3600000 (1h).
#EXECUTION_MISSING_GRACE_MS=3600000

# One-time backfill of the execution columns added in F-01 (trigger mode, queue
# lag, payload sizes, the retry graph). It walks the replica in id order, fills in
# whatever the n8n Postgres still has, and stops for good once it reaches the end
# — rows n8n has already pruned keep NULLs, which is the honest answer.
#
# Time-boxed per cycle and resumable to the row, so it catches up over a few
# syncs instead of stalling one of them. On a 500,000-row replica the whole pass
# took about 35 seconds across two cycles. Raise the budget to finish sooner;
# there is no reason to touch either value otherwise.
#BACKFILL_CHUNK=2000              # rows per pass
#BACKFILL_BUDGET_MS=20000         # how long one sync may spend catching up

# Deep error analytics run from a queue, so a failed extraction is retried rather
# than lost. None of these normally need changing.
#ERROR_BATCH_LIMIT=500            # max queue entries drained per sync cycle
#ERROR_CHUNK_SIZE=50              # execution ids per payload query
#MAX_ERROR_PAYLOAD_BYTES=5242880  # traces larger than this are skipped, not loaded
#MAX_ANALYTICS_ATTEMPTS=5         # retries before an execution is parked as failed

# Retention for the two heavy columns of the error analytics table. The error row
# itself is NEVER deleted — every count, category and chart keeps working. Only
# the raw evidence behind old rows is cleared. 0 means keep forever.
#
# input_data is the payload that entered the failing node: real data from your
# workflows, and the single largest thing in the replica. Nothing in the
# dashboard reads it, so it is aged out by default.
#ERROR_DETAIL_RETENTION_DAYS=30
#
# error_stack is kept forever by default, and you should think before changing
# that. When the error classifier's rules improve, the dashboard re-derives the
# message and category of every stored error FROM the stack. Clearing it means
# those rows keep whatever classification they were given at the time and can
# never be corrected.
#ERROR_STACK_RETENTION_DAYS=0
#
# Clearing a column frees pages inside the database file for reuse, so the file
# stops growing — it does not shrink. To actually reclaim the space, run
# `node src/scripts/optimizeReplica.js --apply` while the app is stopped.

# Query and connection timeouts against the n8n Postgres, in milliseconds. The
# ETL is a background job — failing fast beats holding a connection open, since
# it can always try again next cycle.
#DASHBOARD_DB_STATEMENT_TIMEOUT_MS=60000
#DASHBOARD_DB_CONNECT_TIMEOUT_MS=15000

# How long an ETL lock is honoured without a heartbeat before another instance
# may take over, in milliseconds. Optional, defaults to 60000. Only one instance
# ever runs the ETL; the rest serve reads. You do not need to set this — see
# "Running more than one instance" in the README.
#ETL_LOCK_TTL_MS=60000

# How long a graceful shutdown may take before the process forces its own exit,
# in milliseconds. Optional, defaults to 8000. Keep it BELOW your orchestrator's
# stop grace period (Docker's default is 10s) — if it is longer, the SIGKILL
# lands first and the replica is never checkpointed.
#SHUTDOWN_TIMEOUT_MS=8000

# =============================================================================
# Alerting
# =============================================================================
# Rules and channels are configured in the UI (Alerts page), not here. These are
# the knobs that decide how the engine behaves around them.

# How stale the replica may be before the alert pass refuses to run, in
# milliseconds. Optional, defaults to 1800000 (30 minutes).
#
# This is the guard that stops a stalled ETL from paging you about every
# scheduled workflow at once: silence is measured against the newest execution
# in the replica, so a pipeline that has stopped makes EVERYTHING look dead.
# "Evaluate now" in the UI overrides it, because then a person is watching.
#ALERT_MAX_STALENESS_MS=1800000

# How long after each sync tick the alert pass runs, in milliseconds. Optional,
# defaults to 30000. It runs after the ETL rather than beside it so it judges
# data the cycle has already written instead of racing it.
#ALERT_DELAY_MS=30000

# Whether an alert channel may point at a private or loopback address.
# Optional, defaults to false.
#
# Set this to true if your n8n is on the same host or the same private network
# as the dashboard — which is the normal case for the "trigger an n8n workflow"
# channel. Link-local (169.254.0.0/16, fe80::/10) stays blocked either way: that
# is the cloud metadata endpoint and no alert belongs there.
#ALERT_ALLOW_PRIVATE_TARGETS=false

# How long one delivery attempt may take before it is abandoned, in
# milliseconds. Optional, defaults to 10000.
#ALERT_TIMEOUT_MS=10000

# How many times a failed delivery is retried on later passes before the event
# is left alone. Optional, defaults to 4.
#ALERT_MAX_ATTEMPTS=4

# How many fired alerts are kept. Optional, defaults to 2000. The table records
# suppressed and undelivered events too — "why was I not told" is a question it
# has to be able to answer — so it is pruned rather than kept forever.
#ALERT_EVENT_HISTORY=2000

# =============================================================================
# Error fingerprinting
# =============================================================================
# Rows per chunk, and how long one cycle may spend walking, in milliseconds.
# Optional, default 2000 and 10000. The walk is resumable to the row, so being
# interrupted costs nothing but the current chunk. Once it reaches the end and
# verifies that nothing is left, it costs one settings read per cycle.
#FINGERPRINT_CHUNK=2000
#FINGERPRINT_BUDGET_MS=10000

# =============================================================================
# Business metadata (execution_metadata)
# =============================================================================
# n8n's execution_metadata holds whatever your workflows chose to record, and
# that is not always the harmless order id it sounds like — on this instance it
# contained AI agent replies describing infrastructure.
#
# Keys are always mirrored: they describe WHAT a workflow records, not what it
# recorded. Values are length-capped, and can be dropped entirely.
#SYNC_METADATA_VALUES=true
#METADATA_VALUE_MAX=512

# =============================================================================
# Node profiling (F-12)
# =============================================================================
# "Which node is the bottleneck" cannot be answered from failed executions — the
# failing node stops early and the rest never run — so this samples SUCCESSFUL
# ones. It is the only place the dashboard reads execution payloads it was not
# already going to read, which is why every dial below is a limit.
#
# Executions read per workflow. Small on purpose: node time here is dominated by
# one node per workflow by a factor of ten or more (21.6 s of a 23.2 s
# execution, measured), so five samples separate the bottleneck from everything
# else, and fifty would multiply the bytes for a sharper number nobody needs.
#PROFILE_SAMPLES=5

# Workflows refreshed per sync cycle, and how long one cycle may spend. A
# workflow with no execution newer than its last sample is skipped entirely.
#PROFILE_WORKFLOWS_PER_PASS=6
#PROFILE_BUDGET_MS=15000

# How old a profile may get before it is rebuilt.
#PROFILE_INTERVAL_HOURS=24

# =============================================================================
# Analytics tuning
# =============================================================================
# How far before the requested window the concurrency sweep looks, to catch
# executions that were already running when it started, in milliseconds.
# Optional, defaults to 3600000 (one hour). The longest execution ever recorded
# on this instance is 336 seconds, so an hour is two orders of magnitude of
# margin — and it is what keeps that query an indexed range scan.
#CONCURRENCY_LOOKBACK_MS=3600000

# How many ETL passes are kept in sync_runs, which is what the Dashboard Health
# panel reads. Optional, defaults to 500 — at a five-minute cadence, about 42
# hours of history. The growth figure on that panel can only measure what this
# retains, and it says so.
#SYNC_RUN_HISTORY=500

# =============================================================================
# Logging and diagnostics
# =============================================================================
# error | warn | info | debug. Optional, defaults to info.
#LOG_LEVEL=info

# json | pretty. Optional; defaults to pretty on a TTY and json otherwise, which
# is what a log collector wants without anyone configuring it.
#LOG_FORMAT=json

# Requests slower than this are logged at warn, in milliseconds. Optional,
# defaults to 2000.
#SLOW_REQUEST_MS=2000

# Writes every extracted error payload to disk for troubleshooting. Optional,
# defaults to false. Leave it off: the file contains the raw node input, which
# is real customer data — the one thing this replica otherwise ages out.
#SAVE_DEBUG_ERRORS=false
#DEBUG_ERRORS_PATH=./scratch/debug_errors.json

# Requests per minute per user across the API. Optional, defaults to 300.
#API_RATE_LIMIT_PER_MINUTE=300
